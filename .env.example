# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FISH_AUDIO_API_KEY: Optional Fish Audio API Key for ultra-realistic studio Arabic voice generation.
# Set this in the Secrets panel or .env file to enable Fish Audio TTS (https://fish.audio).
FISH_AUDIO_API_KEY="YOUR_FISH_AUDIO_API_KEY"

# OPENROUTER_API_KEY: Used for Google Gemini 3.8 Flash-Lite TTS (google/gemini-3.8-flash-lite-tts)
# and ultra-efficient book summarization models (DeepSeek-V3, etc.)
OPENROUTER_API_KEY="sk-or-v1-..."

# OPENROUTER_TEXT_MODEL: Optional. OpenRouter model tried first for all text/OCR tasks
# (e.g. "google/gemini-2.5-flash", "deepseek/deepseek-chat"). Falls back to the built-in list.
OPENROUTER_TEXT_MODEL=""

# RATE_LIMIT_PER_MINUTE: Optional. Max AI/TTS requests per visitor IP per minute (default 60).
RATE_LIMIT_PER_MINUTE="60"

# TTS_STYLE_PROMPT: Set to "off" to stop prefixing each voice's dialect/style instruction
# to the Gemini TTS input (use if the model starts reading the instruction aloud).
TTS_STYLE_PROMPT=""
