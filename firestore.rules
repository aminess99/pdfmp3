rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      // Only profile fields; roles are never client-writable
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt']);
      allow delete: if isOwner(userId);
    }

    // Audiobooks Collection
    match /audiobooks/{bookId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Listening minutes: written only by the server (Admin SDK bypasses these rules)
    match /credits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Shared clips: public read; signed-in users create short, well-formed clips; no edits
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['text', 'voiceId', 'bookTitle', 'chapterTitle', 'userId', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 600
        && request.resource.data.voiceId is string && request.resource.data.voiceId.size() <= 40
        && request.resource.data.bookTitle is string && request.resource.data.bookTitle.size() <= 150
        && request.resource.data.chapterTitle is string && request.resource.data.chapterTitle.size() <= 150
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Custom Voices Collection
    match /voices/{voiceId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
